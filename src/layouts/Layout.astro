---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import KeyBindings from "../components/KeyBindings.astro";
import "../style/global.css";
interface Props {
  filename: string;
  title: string;
}

const { filename, title = "Samsara" } = Astro.props;
---

<!doctype html>
<html data-webtui-theme="catppuccin-mocha" lang="en">
  <Head title={title} />
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <KeyBindings />
    <Footer filename={filename} />
  </body>
</html>

<style>
  html,
  body {
    width: 100%;
    height: 100%;
    min-height: 100dvh;
    margin: 0ch auto;
    position: relative;
    overflow-x: hidden;
  }

  body {
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
  }

  main {
    flex: 1;
    padding: 3ch 2ch;
    width: 100%;
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  type VimMode = "NORMAL" | "BLOG" | "NOTES";

  let modeElement = document.getElementById("vim-mode");
  let blogBox = document.getElementById("blog-box");
  let superSecretDeviceNotesToggle = document.getElementById("super-secret");

  const allBlogEntries = document.querySelectorAll(
    ".blog-entry-parent-flex-wrapper",
  );

  const lastPage =
    allBlogEntries.length > 0
      ? Math.max(
          ...Array.from(allBlogEntries, (blogEntry) =>
            Number((blogEntry as HTMLElement).dataset.page),
          ),
        )
      : 1;

  const isKeybindingsOverlayOpen = () =>
    document.getElementById("keybindings-overlay")?.style.display === "block";

  let currentMode: VimMode = "NORMAL";
  let currentIndex = 0;
  let currentPage = 1;
  // which listing the layout is currently driving; used to only reset
  // pagination when the collection actually changes (not when leaving a mode).
  let currentCollection: "blog" | "notes" = "blog";

  // o* key sequence for NOTES mode
  let lastOPress = false;
  const O_SEQUENCE_TIMEOUT = 1000;
  let oSequenceTimer: ReturnType<typeof setTimeout> | null = null;
  const armOPress = () => {
    lastOPress = true;
    if (oSequenceTimer) clearTimeout(oSequenceTimer);
    oSequenceTimer = setTimeout(() => {
      lastOPress = false;
    }, O_SEQUENCE_TIMEOUT);
  };

  // z-prefixed viewport commands (zz / zt / zb)
  let lastZPress = false;
  let zSequenceTimer: ReturnType<typeof setTimeout> | null = null;
  const armZPress = () => {
    lastZPress = true;
    if (zSequenceTimer) clearTimeout(zSequenceTimer);
    zSequenceTimer = setTimeout(() => {
      lastZPress = false;
    }, O_SEQUENCE_TIMEOUT);
  };

  const clampedPage = (currentPage: number) => {
    if (currentPage <= 0) return 1;
    if (currentPage > lastPage) return lastPage;
    return currentPage;
  };

  const clampEntries = (
    entries: NodeListOf<Element> | Element[],
    currentPage: number,
  ) => {
    return [...entries].filter((entry) => {
      if (Number((entry as HTMLElement).dataset.page) === currentPage)
        return entry;
    }) as HTMLElement[];
  };

  // blogMode initial state
  const initialEntries =
    blogBox?.querySelectorAll(
      '.blog-entry-parent-flex-wrapper[data-collection="blog"]',
    ) ?? ([] as Element[]);
  let clampedEntries: HTMLElement[] = clampEntries(initialEntries, currentPage);

  const clampedIndex = (currentIndex: number) => {
    if (clampedEntries.length === 0) return 0;
    if (currentIndex < 0) return 0;
    if (currentIndex > clampedEntries.length - 1)
      return clampedEntries.length - 1;
    return currentIndex;
  };

  // define a custom event to handle mode changes async
  const NormalModeChangeEvent = new CustomEvent<VimMode>("MODE_CHANGE", {
    detail: "NORMAL",
  });

  const BlogModeChangeEvent = new CustomEvent<VimMode>("MODE_CHANGE", {
    detail: "BLOG",
  });

  const NotesModeChangeEvent = new CustomEvent<VimMode>("MODE_CHANGE", {
    detail: "NOTES",
  });

  // define a custom event to handle keybindings display
  const ToggleKeybindingsEvent = new CustomEvent<boolean>("TOGGLE_KEYBINDINGS");

  const refreshActiveState = () => {
    if (!blogBox) {
      clampedEntries = [];
      return;
    }
    const collection = currentMode === "NOTES" ? "notes" : "blog";
    const allEntries = blogBox.querySelectorAll(
      `.blog-entry-parent-flex-wrapper[data-collection="${collection}"]`,
    );
    clampedEntries = clampEntries(allEntries, currentPage);
    currentIndex = clampedIndex(currentIndex);
  };

  superSecretDeviceNotesToggle?.addEventListener("click", () => {
    // toggle NOTES like the `o*` sequence, so it stays usable on touch devices
    if (currentMode === "NOTES") {
      currentMode = "BLOG";
      document.dispatchEvent(BlogModeChangeEvent);
    } else {
      currentMode = "NOTES";
      document.dispatchEvent(NotesModeChangeEvent);
    }
  });

  document.addEventListener("MODE_CHANGE", ((event: CustomEvent) => {
    if (modeElement) {
      if (event.detail == "NOTES") {
        modeElement.textContent = "NOTES";
        modeElement.setAttribute("variant-", "red");
      } else if (event.detail == "BLOG") {
        modeElement.textContent = "BLOG";
        modeElement.setAttribute("variant-", "blue");
      } else if (event.detail == "NORMAL") {
        modeElement.textContent = "NORMAL";
        modeElement.setAttribute("variant-", "blue");
      }
    }
    if (clampedEntries.length > 0) {
      clampedEntries[currentIndex]?.classList.remove("selected");
    }
    // blog and notes have different page counts; only reset when the collection
    // actually changes — leaving to NORMAL keeps the current page.
    const targetCollection = event.detail === "NOTES" ? "notes" : "blog";
    if (targetCollection !== currentCollection) {
      currentCollection = targetCollection;
      currentPage = 1;
      blogBox?.setAttribute("data-pagination-index", "1");
    }
    refreshActiveState();
    if (
      (event.detail == "BLOG" || event.detail == "NOTES") &&
      clampedEntries.length > 0
    ) {
      currentIndex = 0;
      clampedEntries[0].classList.add("selected");
    }
  }) as EventListener);

  const moveSelection = (delta: number) => {
    if (clampedEntries.length != 0) {
      let currSelection = clampedEntries[currentIndex];
      currSelection.classList.remove("selected");
      currentIndex = clampedIndex(currentIndex + delta);
      const nextSelection = clampedEntries[currentIndex];
      nextSelection.classList.add("selected");
    }
  };

  const movePage = (delta: number) => {
    if (lastPage > 1 && blogBox) {
      // clear the current selection *before* clampedEntries is recomputed for
      // the new page, otherwise the old highlight is orphaned and accumulates
      if (clampedEntries.length > 0) {
        clampedEntries[currentIndex]?.classList.remove("selected");
      }
      currentPage = clampedPage(currentPage + delta);
      blogBox.setAttribute("data-pagination-index", currentPage.toString());
      refreshActiveState();
      currentIndex = 0;
      if (clampedEntries.length > 0) {
        clampedEntries[0].classList.add("selected");
      }
    }
  };

  // scrolling is only active off the main page
  const isScrollingRoute = () => window.location.pathname !== "/";

  // one TUI cell (1ch) in px, measured once and cached
  let cachedCh = 0;
  const oneCh = () => {
    if (cachedCh > 0) return cachedCh;
    const probe = document.createElement("span");
    probe.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;width:1ch";
    document.body.appendChild(probe);
    cachedCh = probe.getBoundingClientRect().width;
    probe.remove();
    if (!cachedCh) {
      cachedCh =
        parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    }
    return cachedCh;
  };

  // `html, body { height: 100%; overflow-x: hidden }` makes `body` the scroll
  // container rather than the window, so scroll whichever element actually
  // overflows instead of assuming `window`.
  const scrollViewport = (delta: number) => {
    const html = document.documentElement;
    const target = html.scrollHeight > html.clientHeight ? html : document.body;
    target.scrollBy(0, delta);
  };

  // vim-like scrolling, on every route except the main page
  const scrollByLine = (dir: number) => {
    if (isScrollingRoute()) scrollViewport(dir * oneCh());
  };

  const scrollByHalfPage = (dir: number) => {
    if (isScrollingRoute())
      scrollViewport(dir * Math.round(window.innerHeight / 2));
  };

  // ---- prototype: block cursor (option A) ----
  const collectProseBlocks = () => {
    const prose = document.querySelector<HTMLElement>(".prose");
    if (!prose) return [] as HTMLElement[];
    return Array.from(prose.children).filter(
      (el) => el.textContent?.trim() || el.querySelector("img"),
    ) as HTMLElement[];
  };

  let cursorBlocks: HTMLElement[] = [];
  let cursorIndex = 0;
  let cursorActive = false;
  let lastCursorNav = 0;
  const markCursorNav = () => (lastCursorNav = performance.now());

  // touch devices get no block cursor at all
  const isCoarsePointer = () =>
    window.matchMedia?.("(pointer: coarse)").matches ?? false;

  const cursorEligible = () =>
    !isCoarsePointer() &&
    window.location.pathname !== "/" &&
    cursorBlocks.length > 0;

  // only "live" once the user has hit a keyboard motion
  const hasBlockCursor = () => cursorEligible() && cursorActive;

  const highlightCursor = () => {
    document
      .querySelectorAll(".prose .cursor-block")
      .forEach((el) => el.classList.remove("cursor-block"));
    if (cursorActive) cursorBlocks[cursorIndex]?.classList.add("cursor-block");
  };

  const nearestBlockIndex = () => {
    const anchor = window.innerHeight / 2;
    let best = 0;
    let bestDist = Infinity;
    cursorBlocks.forEach((el, i) => {
      const rect = el.getBoundingClientRect();
      const d = Math.abs(rect.top + rect.height / 2 - anchor);
      if (d < bestDist) {
        bestDist = d;
        best = i;
      }
    });
    return best;
  };

  const alignCursor = (where: "top" | "center" | "bottom") => {
    const el = cursorBlocks[cursorIndex];
    if (!el) return;
    markCursorNav();
    const rect = el.getBoundingClientRect();
    const target =
      where === "top"
        ? 0
        : where === "bottom"
          ? window.innerHeight - rect.height
          : (window.innerHeight - rect.height) / 2;
    scrollViewport(rect.top - target);
  };

  const revealCursor = () => {
    const el = cursorBlocks[cursorIndex];
    if (!el) return;
    markCursorNav();
    const rect = el.getBoundingClientRect();
    const margin = window.innerHeight * 0.15;
    if (rect.top < margin) scrollViewport(rect.top - margin);
    else if (rect.bottom > window.innerHeight - margin)
      scrollViewport(rect.bottom - (window.innerHeight - margin));
  };

  const moveCursor = (delta: number) => {
    if (!cursorEligible()) return;
    cursorIndex = Math.max(
      0,
      Math.min(cursorIndex + delta, cursorBlocks.length - 1),
    );
    highlightCursor();
    revealCursor();
  };

  const initBlockCursor = () => {
    cursorBlocks = collectProseBlocks();
    cursorIndex = cursorBlocks.length > 0 ? nearestBlockIndex() : 0;
    cursorActive = false;
    highlightCursor();
  };

  // Scrolling by any means other than j/k / Ctrl-d/u (trackpad, wheel, arrows)
  // turns the cursor off until the next keyboard motion. `lastCursorNav` marks
  // our own programmatic scrolls so they don't immediately switch it off.
  const deactivateCursor = () => {
    if (!cursorActive) return;
    cursorActive = false;
    highlightCursor();
  };

  // `scroll` events don't bubble, and here `body` (not the window) is the
  // scroller — so listen in the capture phase to catch it at all.
  document.addEventListener(
    "scroll",
    () => {
      if (performance.now() - lastCursorNav < 150) return;
      deactivateCursor();
    },
    { capture: true, passive: true },
  );

  // trackpad / mouse wheel
  window.addEventListener("wheel", deactivateCursor, { passive: true });

  initBlockCursor();

  document.addEventListener("keydown", (event) => {
    let pressedKey = event.key;
    // don't handle inputs when keybindings are open, unless quit
    if (
      isKeybindingsOverlayOpen() &&
      pressedKey !== "Escape" &&
      pressedKey !== "q"
    )
      return;
    switch (pressedKey) {
      case "p":
        if (window.location.pathname != "/portfolio") navigate("/portfolio");
        break;
      case "n":
        if (window.location.pathname != "/now") navigate("/now");
        break;
      case "o":
        // `o` then `*` (within 1s) toggles NOTES mode from any mode
        if (window.location.pathname == "/") {
          armOPress();
        }
        break;
      case "*":
        if (window.location.pathname == "/" && lastOPress) {
          if (currentMode == "NOTES") {
            currentMode = "BLOG";
            document.dispatchEvent(BlogModeChangeEvent);
          } else {
            currentMode = "NOTES";
            document.dispatchEvent(NotesModeChangeEvent);
          }
        }
        lastOPress = false;
        break;
      case "z":
        if (hasBlockCursor()) {
          if (lastZPress) {
            alignCursor("center");
            lastZPress = false;
          } else {
            armZPress();
          }
        }
        break;
      case "t":
        if (hasBlockCursor() && lastZPress) {
          alignCursor("top");
          lastZPress = false;
        }
        break;
      case "b":
        if (lastZPress) {
          lastZPress = false;
          if (hasBlockCursor()) alignCursor("bottom");
          break;
        }
        if (
          window.location.pathname == "/" &&
          (currentMode == "NORMAL" || currentMode == "NOTES")
        ) {
          currentMode = "BLOG";
          document.dispatchEvent(BlogModeChangeEvent);
        }
        break;
      case "Escape":
        event.preventDefault();
        if (isKeybindingsOverlayOpen()) {
          document.dispatchEvent(ToggleKeybindingsEvent);
          break;
        }
        if (
          window.location.pathname == "/" &&
          (currentMode == "BLOG" || currentMode == "NOTES")
        ) {
          currentMode = "NORMAL";
          document.dispatchEvent(NormalModeChangeEvent);
        } else if (window.location.pathname !== "/") {
          navigate("/");
        }
        break;
      case "j":
        if (
          window.location.pathname == "/" &&
          (currentMode == "BLOG" || currentMode == "NOTES")
        )
          moveSelection(1);
        else if (cursorEligible()) {
          if (!cursorActive) {
            cursorActive = true;
            cursorIndex = nearestBlockIndex();
          }
          moveCursor(1);
        } else scrollByLine(1);
        break;
      case "k":
        if (
          window.location.pathname == "/" &&
          (currentMode == "BLOG" || currentMode == "NOTES")
        )
          moveSelection(-1);
        else if (cursorEligible()) {
          if (!cursorActive) {
            cursorActive = true;
            cursorIndex = nearestBlockIndex();
          }
          moveCursor(-1);
        } else scrollByLine(-1);
        break;
      case "h":
        if (
          window.location.pathname == "/" &&
          (currentMode == "BLOG" || currentMode == "NOTES")
        )
          movePage(-1);
        break;
      case "l":
        if (
          window.location.pathname == "/" &&
          (currentMode == "BLOG" || currentMode == "NOTES")
        )
          movePage(1);
        break;
      case "d":
        if (event.ctrlKey && isScrollingRoute()) {
          event.preventDefault();
          // Ctrl-d/u drive the cursor too: scroll half a page, then the cursor
          // lands on whatever block is now at the center.
          if (cursorEligible()) markCursorNav();
          scrollByHalfPage(1);
          if (cursorEligible()) {
            cursorActive = true;
            cursorIndex = nearestBlockIndex();
            highlightCursor();
          }
        }
        break;
      case "u":
        if (event.ctrlKey && isScrollingRoute()) {
          event.preventDefault();
          if (cursorEligible()) markCursorNav();
          scrollByHalfPage(-1);
          if (cursorEligible()) {
            cursorActive = true;
            cursorIndex = nearestBlockIndex();
            highlightCursor();
          }
        }
        break;
      case "Enter":
        if (
          window.location.pathname == "/" &&
          (currentMode == "BLOG" || currentMode == "NOTES")
        ) {
          event.preventDefault();
          if (clampedEntries.length != 0) {
            let currSelection = clampedEntries[clampedIndex(currentIndex)];
            let anchorTagSlug = currSelection
              .querySelector(".blog-entry-parent-flex")
              .getElementsByTagName("a")[0]
              .getAttribute("href");
            if (anchorTagSlug) navigate(anchorTagSlug);
          }
        }
        break;
      case "?":
        document.dispatchEvent(ToggleKeybindingsEvent);
        break;
      case "q":
        if (isKeybindingsOverlayOpen()) {
          document.dispatchEvent(ToggleKeybindingsEvent);
        }

        break;
    }
  });
</script>
