---
import { getCollection } from "astro:content";
import BlogEntry from "../components/BlogEntry.astro";

const allBlogPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allNotes = (await getCollection("notes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const BLOG_ROUTE = "/blog/";
const NOTES_ROUTE = "/notes/";
const PAGINATION_SIZE = 7;
---

<section class="section-flex">
  <div
    id="blog-box"
    box-="square"
    data-pagination-index={1}
    data-collection="blog"
    shear-="both"
  >
    <div class="header">
      <span id="blog-box-heading">blog</span>
    </div>
    {
      allBlogPosts.map((post, index) => {
        return (
          <div
            class="blog-entry-parent-flex-wrapper"
            data-page={Math.floor(index / PAGINATION_SIZE) + 1}
            data-collection="blog"
          >
            <BlogEntry
              title={post.data.title}
              slug={`${BLOG_ROUTE}${post.id}`}
              dateOfPublication={post.data.pubDate.toLocaleDateString()}
            />
          </div>
        );
      })
    }
    {
      allNotes.map((post, index) => {
        return (
          <div
            class="blog-entry-parent-flex-wrapper"
            data-page={Math.floor(index / PAGINATION_SIZE) + 1}
            data-collection="notes"
            style="display: none"
          >
            <BlogEntry
              title={post.data.title}
              slug={`${NOTES_ROUTE}${post.id}`}
              dateOfPublication={post.data.pubDate.toLocaleDateString()}
            />
          </div>
        );
      })
    }
    <div id="blog-box-footer-div" style="align-self:end; gap:0">
      <span id="blog-box-footer">
        <span id="prev-page">&lt;</span><span
          id="page-number-current"
          style="font-weight:600">1</span
        >&sol;<span id="page-number-last" style="font-weight:600">1</span><span
          id="next-page">&gt;</span
        >
      </span>
    </div>
  </div>
</section>
<style>
  #blog-box {
    display: flex;
    min-width: 45%;
    max-width: 60%;
    min-height: 3lh;
    flex-direction: column;
    gap: 0.2ch;
    font-size: 1.5ch;
  }

  @media (max-width: 900px) {
    #blog-box {
      min-width: 70%;
      max-width: 80%;
      min-height: 3lh;
      font-size: 1.4ch;
    }
  }

  @media (max-width: 500px) {
    #blog-box {
      min-width: 90%;
      max-width: 95%;
      min-height: 3lh;
      font-size: 1.2ch;
    }
  }
  #blog-box-heading {
    font-weight: 600;
  }

  #blog-box .selected {
    color: var(--mauve);
  }

  #blog-box :global(.selected .blog-entry-parent-flex a) {
    color: var(--mauve);
  }

  #blog-box-heading {
    background-color: var(--background0);
    padding: 0 1ch;
  }
  #blog-box-footer {
    background-color: var(--background0);
    padding: 0 1ch;
  }
  #prev-page,
  #next-page {
    cursor: pointer;
    color: var(--mauve);
    font-weight: 600;
  }
</style>

<script>
  let dataPaginationIndex = 1;
  let activeCollection: "blog" | "notes" = "blog";
  const blogBox = document.getElementById("blog-box");
  const pageNumberCurrent = document.getElementById("page-number-current");
  const pageNumberLast = document.getElementById("page-number-last");
  const prevPage = document.getElementById("prev-page");
  const nextPage = document.getElementById("next-page");
  const blogBoxHeading = document.getElementById("blog-box-heading");
  const blogFooterDiv = document.getElementById("blog-box-footer-div");

  let startX = 0;
  let endX = 0;
  let startY = 0;
  let endY = 0;

  const getActiveEntries = (): HTMLElement[] => {
    const all = blogBox?.querySelectorAll<HTMLElement>(
      `.blog-entry-parent-flex-wrapper[data-collection="${activeCollection}"]`,
    );
    return all ? [...all] : [];
  };

  const lastPageFor = (collection: "blog" | "notes") => {
    const entries = blogBox?.querySelectorAll<HTMLElement>(
      `.blog-entry-parent-flex-wrapper[data-collection="${collection}"]`,
    );
    if (!entries || entries.length === 0) return 1;
    return Math.max(
      ...Array.from(entries, (entry) =>
        Number((entry as HTMLElement).dataset.page),
      ),
    );
  };

  let lastPage = lastPageFor("blog");

  if (blogFooterDiv)
    blogFooterDiv.style.visibility = lastPage <= 1 ? "hidden" : "visible";

  const clampedPage = (page: number) => {
    if (page < 1) return 1;
    if (page > lastPage) return lastPage;
    return page;
  };

  const updateVisiblePosts = () => {
    if (pageNumberCurrent)
      pageNumberCurrent.innerText = dataPaginationIndex.toString();
    const allEntries = blogBox?.querySelectorAll<HTMLElement>(
      ".blog-entry-parent-flex-wrapper",
    );
    if (allEntries) {
      allEntries.forEach((entry) => {
        const el = entry as HTMLElement;
        const matchesCollection = el.dataset.collection === activeCollection;
        const matchesPage =
          parseInt(el.dataset.page ?? "0") === dataPaginationIndex;
        el.style.display = matchesCollection && matchesPage ? "" : "none";
      });
    }
    if (prevPage)
      prevPage.style.visibility =
        dataPaginationIndex <= 1 ? "hidden" : "visible";
    if (nextPage)
      nextPage.style.visibility =
        dataPaginationIndex >= lastPage ? "hidden" : "visible";
  };

  const navigatePage = (delta: number) => {
    dataPaginationIndex = clampedPage(dataPaginationIndex + delta);
    blogBox?.setAttribute(
      "data-pagination-index",
      dataPaginationIndex.toString(),
    );
    updateVisiblePosts();
  };

  const setActiveCollection = (collection: "blog" | "notes") => {
    activeCollection = collection;
    dataPaginationIndex = 1;
    lastPage = lastPageFor(collection);
    blogBox?.setAttribute("data-collection", collection);
    if (blogBoxHeading) blogBoxHeading.textContent = collection;
    blogBox?.setAttribute("data-pagination-index", "1");
    if (blogFooterDiv)
      blogFooterDiv.style.visibility = lastPage <= 1 ? "hidden" : "visible";
    if (pageNumberLast)
      pageNumberLast.innerText = lastPage > 1 ? lastPage.toString() : "1";
    updateVisiblePosts();
  };

  document.addEventListener("MODE_CHANGE", ((event: CustomEvent) => {
    const target = event.detail === "NOTES" ? "notes" : "blog";
    // only reset pagination when the collection changes; returning to NORMAL
    // (Esc) should keep the page the user was on.
    if (target !== activeCollection) {
      setActiveCollection(target);
    } else {
      updateVisiblePosts();
    }
  }) as EventListener);

  const handleSwipe = (
    startX: number,
    endX: number,
    startY: number,
    endY: number,
  ) => {
    const threshold = 50;
    const dx = endX - startX;
    const dy = endY - startY;
    if (Math.abs(dy) > Math.abs(dx)) return;
    if (dx < -threshold) {
      navigatePage(1);
    }
    if (dx > threshold) {
      navigatePage(-1);
    }
  };

  updateVisiblePosts();

  prevPage?.addEventListener("click", () => {
    navigatePage(-1);
  });

  nextPage?.addEventListener("click", () => {
    navigatePage(1);
  });

  blogBox?.addEventListener("touchstart", (e) => {
    e.preventDefault();
    startX = e.changedTouches[0].screenX;
    startY = e.changedTouches[0].screenY;
  });

  blogBox?.addEventListener("touchend", (e) => {
    e.preventDefault();
    endX = e.changedTouches[0].screenX;
    endY = e.changedTouches[0].screenY;
    handleSwipe(startX, endX, startY, endY);
  });

  const paginationObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "data-pagination-index"
      ) {
        if (blogBox && blogBox.dataset.paginationIndex) {
          dataPaginationIndex = parseInt(blogBox.dataset.paginationIndex);
        }
        updateVisiblePosts();
      }
    });
  });

  paginationObserver.observe(blogBox as Node, {
    attributes: true,
    attributeFilter: ["data-pagination-index"],
  });
</script>

